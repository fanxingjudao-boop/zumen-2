{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schema/deleted.json",
  "title": "DeletedItems",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "deleted_slices",
    "deleted_containers"
  ],
  "properties": {
    "deleted_slices": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "default": []
    },
    "deleted_containers": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "default": []
    }
  }
}