{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schema/release_manifest.json",
  "title": "ReleaseManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release",
    "created_at",
    "generator",
    "counts",
    "content_hash"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "from_version"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "from_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "const": "cad-repo-maintainer"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "build": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "containers",
        "slices"
      ],
      "properties": {
        "containers": {
          "type": "integer",
          "minimum": 0
        },
        "slices": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "content_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "manifest_sha256"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "sha256"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}